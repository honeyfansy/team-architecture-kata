{
  "说明": "复制为 llm.config.json 后修改，或直接设置环境变量",
  "provider": "anthropic",
  "baseURL": "",
  "apiKey": "",
  "defaultModel": "",
  "modelList": [],
  "modelMap": {},
  "示例_按需取消注释": true,
  "场景1_Claude官方API": {
    "provider": "anthropic",
    "baseURL": "https://api.anthropic.com",
    "apiKey": "${ANTHROPIC_API_KEY}",
    "defaultModel": "claude-sonnet-4-6",
    "modelMap": {
      "facilitator": "claude-sonnet-4-6",
      "domain_architect": "claude-sonnet-4-6",
      "system_architect": "claude-sonnet-4-6"
    }
  },
  "场景2_OpenAI官方API": {
    "provider": "openai",
    "baseURL": "https://api.openai.com/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "defaultModel": "gpt-4o",
    "modelMap": {
      "facilitator": "gpt-4o-mini",
      "domain_architect": "gpt-4o",
      "system_architect": "gpt-4o-mini"
    }
  },
  "场景3_LiteLLM代理": {
    "provider": "openai-compatible",
    "baseURL": "http://localhost:4000/v1",
    "apiKey": "sk-...",
    "defaultModel": "claude-sonnet-4-6",
    "modelMap": {
      "facilitator": "claude-sonnet-4-6",
      "domain_architect": "claude-opus-4-6",
      "system_architect": "claude-sonnet-4-6"
    }
  },
  "场景4_Ollama本地模型": {
    "provider": "openai-compatible",
    "baseURL": "http://localhost:11434/v1",
    "apiKey": "ollama",
    "defaultModel": "llama3",
    "modelList": ["llama3", "qwen2", "mistral"],
    "modelMap": {
      "facilitator": "llama3",
      "domain_architect": "qwen2",
      "system_architect": "mistral"
    }
  }
}
